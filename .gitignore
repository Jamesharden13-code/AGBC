# ==================================================
# AGBC - Git Ignore
# ==================================================

# ==================================================
# React Native - App
# ==================================================

App/node_modules/
App/.expo/
App/.expo-shared/

# React Native Android
App/android/.gradle/
App/android/build/
App/android/app/build/
App/android/local.properties

# React Native iOS
App/ios/Pods/
App/ios/build/

# Metro
App/.metro-health-check*

# Logs
App/npm-debug.log*
App/yarn-debug.log*
App/yarn-error.log*

# ==================================================
# Django - Backend
# ==================================================

# Python cache
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]

# Virtual environments
backend/venv/
backend/.venv/
backend/env/

# Django
backend/*.log

# SQLite database
backend/db.sqlite3
backend/db.sqlite3-journal

# ==================================================
# Environment variables
# ==================================================

.env
.env.*
!.env.example

App/.env
backend/.env

# ==================================================
# IDE
# ==================================================

.vscode/
.idea/

# ==================================================
# Operating System
# ==================================================

.DS_Store
Thumbs.db

